# Energy Trading environment variable template
# Copy this file to .env and fill in values as needed.
# All variables use the ET_ prefix (defined in src/energy_trading/config.py).

# -----------------------------------------------------------------------
# Market configuration
# -----------------------------------------------------------------------
# Comma-separated list of ERCOT settlement-point hubs.
# ET_HUBS=["HB_NORTH","HB_SOUTH","HB_WEST","HB_HOUSTON"]

# -----------------------------------------------------------------------
# External API keys
# -----------------------------------------------------------------------
# Required for wind/solar generation and gas price features (run_eia).
# Register free at https://www.eia.gov/opendata/
# ET_EIA_API_KEY=your_api_key_here

# -----------------------------------------------------------------------
# File-system paths
# -----------------------------------------------------------------------
# Absolute path to the data directory.  Defaults to <project_root>/data.
# ET_DATA_DIR=/path/to/data

# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------
# One of: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
# ET_LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# Data-quality thresholds
# -----------------------------------------------------------------------
# ET_PRICE_FLOOR=-500.0
# ET_PRICE_CAP=10000.0
# ET_MAX_MISSING_HOURS_PCT=0.01
